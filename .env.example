# PostgreSQL/Supabase connection string.
# Never commit or share the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Supabase Storage for uploaded media and videos.
# The bucket must be public for media URLs to be readable by the frontend.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Server-side secret only. Never expose this key with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="media"

# Required together for the first principal administrator on a fresh database.
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Optional initial administrator profile.
ADMIN_INITIAL_NAME="Administrateur principal"
ADMIN_INITIAL_PHONE=""

# Optional master code, at least 12 characters if configured.
ADMIN_MASTER_PASSWORD="REPLACE_WITH_A_STRONG_SECRET"
